# The docker-compose database from this repo's quickstart:
DATABASE_URL=postgres://usernames:usernames_dev@127.0.0.1:55432/usernames

# ── usernames-indexer ────────────────────────────────────────────────────────
IDENTITY_NAMES_ADDRESS=0x0000000000000000000000000000000000000000
# HANDLE_ESCROW_ADDRESS=0x...  # optional: the HandleEscrow resolving through the registry above
RPC_URL=http://127.0.0.1:8545
CHAIN_NAMES=eden             # the names this chain goes by in an ENS name, comma-separated
# CHAIN_ID=3735928814        # optional here: refuse to start on the wrong chain
# CONFIRMATIONS=5
# POLL_INTERVAL=5s
# MAX_BLOCK_RANGE=10000
# START_BLOCK=
# STALE_AFTER=80s           # readers trust a report this long; unset = 4×poll + 1m

# ── usernames-api ────────────────────────────────────────────────────────────
# The API serves every chain the indexers wrote into the database; it takes no
# chain or contract settings.
# LISTEN_ADDR=127.0.0.1:8080

# ── usernames-api: the ENS CCIP-Read gateway ─────────────────────────────────
# Unset ENS_SIGNER_KEY leaves the route unmounted entirely.
# ENS_SIGNER_KEY=0x...        # a hex key, or a KMS key id / alias/… / ARN
# ENS_RESOLVER_ADDRESS=0x...   # required with a key; answers are bound to it
# ENS_CHAIN_ID=1               # the chain of the ENS registry the resolver is set in (11155111 for Sepolia)
# ENS_DOMAIN=handles.link      # the domain the names sit under (testnet.handles.link)
# ENS_TTL=5m
# ENS_MAX_LAG_BLOCKS=32
