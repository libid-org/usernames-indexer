# The docker-compose database from this repo's quickstart:
DATABASE_URL=postgres://usernames:usernames_dev@127.0.0.1:55432/usernames

# ── Both binaries ────────────────────────────────────────────────────────────
IDENTITY_NAMES_ADDRESS=0x0000000000000000000000000000000000000000

# ── usernames-indexer (the write half) ───────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=3735928814        # optional here: refuse to start on the wrong chain
# CONFIRMATIONS=5
# POLL_INTERVAL_SECS=5
# MAX_BLOCK_RANGE=10000
# START_BLOCK=

# ── usernames-api (the read half) ────────────────────────────────────────────
# REQUIRED, and left uncommented on purpose: the API talks to no chain, so it
# cannot discover which chain's rows it serves. Compose interpolates every
# service's environment before it selects one, so leaving this commented fails
# even `docker compose up -d postgres`, with "required variable CHAIN_ID is
# missing a value".
CHAIN_ID=3735928814
# LISTEN_ADDR=127.0.0.1:8080

# ── usernames-api: the ENS CCIP-Read gateway ─────────────────────────────────
# Unset ENS_SIGNER_KEY leaves the route unmounted entirely.
# ENS_SIGNER_KEY=0x...
# ENS_RESOLVER_ADDRESS=0x...   # required with a key; answers are bound to it
# ENS_CHAINS=3735928814:eden,8453:base  # a SET; anything outside gets a 503
# ENS_SOURCE=mirror                      # or `chain` to read IdentityNames over RPC
# ENS_RPC_URLS=3735928814=https://…
# ENS_CONTRACTS=8453=0x…              # only where IdentityNames differs
# ENS_TTL_SECS=300
# ENS_MAX_LAG_BLOCKS=32
