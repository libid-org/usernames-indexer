# The docker-compose database from this repo's quickstart:
DATABASE_URL=postgres://usernames:usernames_dev@127.0.0.1:55432/usernames

# ── Both binaries ────────────────────────────────────────────────────────────
IDENTITY_NAMES_ADDRESS=0x0000000000000000000000000000000000000000

# ── usernames-indexer (the write half) ───────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=3735928814        # optional here: refuse to start on the wrong chain
# CONFIRMATIONS=5
# POLL_INTERVAL_SECS=5
# MAX_BLOCK_RANGE=10000
# START_BLOCK=

# ── usernames-api (the read half) ────────────────────────────────────────────
# CHAIN_ID is REQUIRED for the API: it talks to no chain, so it cannot
# discover which chain's rows it serves.
# CHAIN_ID=3735928814
# LISTEN_ADDR=127.0.0.1:8080
